# Server Port
PORT=3001

# === Primary database (Supabase Postgres) ===
# Required for brandify sessions, caption pipeline, and public variations.
# Session mode: port 5432  |  Transaction pooler (Render): port 6543 + ?pgbouncer=true
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# === AgentCash Wallet (for paying upstream APIs) ===
# Base64-encode your ~/.agentcash/wallet.json and paste here for production
# Run: cat ~/.agentcash/wallet.json | base64 | tr -d '\n'
AGENTCASH_WALLET_BASE64=

# === x402 Incoming Payments ===
# Your EVM wallet address to RECEIVE payments from callers
X402_RECEIVER_ADDRESS=0x054469C7Ed9560706148a37e75017FA9E08b3980

# x402 facilitator URL (Coinbase CDP facilitator for Base mainnet, or x402.org for Base Sepolia testnet)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Required when using the CDP facilitator on Base mainnet
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Use "base" for mainnet (requires CDP facilitator) or "base-sepolia" for x402.org testnet
X402_NETWORK=base

# Per-route pricing in USD (override defaults here)
X402_PRICE_SESSION_START=0.19
X402_PRICE_GENERATE=0.49
X402_PRICE_RATE=0.01
X402_PRICE_CAPTION_SUGGEST=0.10
X402_PRICE_CAPTION_RATE=0.01

# === Primary database (Supabase Postgres) ===
# Required for brandify sessions, caption pipeline, and public variations.
# Session mode: port 5432  |  Transaction pooler (Render): port 6543 + ?pgbouncer=true
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Public origin URL used in /openapi.json (defaults to Render URL if unset)
X402_PUBLIC_ORIGIN=https://rekt-ceo-brandification.onrender.com

# Contact email in OpenAPI (used for x402scan/Poncho ownership verification)
X402_CONTACT_EMAIL=contact@rektceo.club

# CORS (comma-separated). Include rekt_admin Vite dev origin for CMO Workshop.
CORS_ORIGINS=https://www.rektceo.club,http://localhost:3000,http://localhost:5173

# === CMO Workshop (admin + AgentCash research) ===
ADMIN_API_KEY=
CAMPAIGNS_API_URL=http://localhost:4047
CMO_STRATEGY_MODE=campaign
CMO_LAUNCH_URL=https://rektceo.com/launch
CMO_MEME_GEN_URL=https://rektceo.com/memes
X_READ_PROVIDER=agentcash
CMO_MONTHLY_AGENTCASH_BUDGET_USD=50
COMPETITION_CACHE_TTL_HOURS=6
KOL_TIER_A_INTERVAL_HOURS=6
KOL_TIER_B_INTERVAL_HOURS=24
CMO_WALLET_LOW_BALANCE_USD=5.00
CMO_WALLET_CRITICAL_BALANCE_USD=1.00
CMO_WALLET_CHECK_INTERVAL_MIN=15
X402_PRICE_CMO_COMPETITION=0.25
X402_PRICE_CMO_KOL=0.15
X402_PRICE_CMO_TRENDS=0.06
X402_PRICE_CMO_CONTENT_DRAFT=0.05
X402_PRICE_CMO_BRAND_MENTIONS=0.08
X402_PRICE_CMO_KOL_OPPS=0.12
X402_PRICE_CMO_CAMPAIGN_BRIEF=0.10
# Research intel (~3× AgentCash)
X402_PRICE_CMO_TOPICS=0.21
X402_PRICE_CMO_SOCIAL_PULSE=0.36
X402_PRICE_CMO_NEWS_EVENTS=0.18
X402_PRICE_CMO_INTEL_PACK=0.75
# Content stages (~3×); day/batch stay ~2×
X402_PRICE_CMO_CURATE=0.18
X402_PRICE_CMO_SELECT_TEMPLATE=0.03
X402_PRICE_CMO_BRANDIFY=0.48
X402_PRICE_CMO_CAPTION=0.24
# Day package = 2× AgentCash internal estimate (~$0.30 → $0.60). Override to pin exactly:
# X402_PRICE_CMO_DAY_PACKAGE=0.60
CMO_DAY_MARKUP=2
CMO_STAGE_MARKUP=3
CMO_INTERNAL_LIGHTREEL_USD=0.06
CMO_INTERNAL_UPLOAD_USD=0.01
CMO_INTERNAL_VISION_USD=0.03
CMO_INTERNAL_FLUX_USD=0.12
CMO_INTERNAL_CAPTION_USD=0.08
CMO_INTERNAL_SELECT_USD=0.01
X402_PRICE_TEMPLATES_LIST=0.01
X402_PRICE_TEMPLATES_DETAIL=0.01
X402_PRICE_TEMPLATES_IMAGE=0.02
CMO_DEFAULT_DAYS=7

# Sync meme templates from rekt_website:
#   node scripts/sync-meme-templates.js

# Security notes:
# - X402_RECEIVER_ADDRESS receives caller USDC (merchant wallet)
# - AGENTCASH_WALLET_BASE64 pays upstream StableSocial/Enrich/Studio (separate spend wallet)
# - ADMIN_API_KEY protects admin-only mutate routes (compose, schedule, CRUD)
# - Never commit real wallet secrets or CDP keys