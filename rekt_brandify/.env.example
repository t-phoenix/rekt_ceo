# Server Port
PORT=3001

# === Primary database (Supabase Postgres) ===
# Required for brandify sessions, caption pipeline, and public variations.
# Session mode: port 5432  |  Transaction pooler (Render): port 6543 + ?pgbouncer=true
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# === AgentCash Wallet (for paying upstream APIs) ===
# Base64-encode your ~/.agentcash/wallet.json and paste here for production
# Run: cat ~/.agentcash/wallet.json | base64 | tr -d '\n'
AGENTCASH_WALLET_BASE64=

# === x402 Incoming Payments ===
# Your EVM wallet address to RECEIVE payments from callers
X402_RECEIVER_ADDRESS=0x054469C7Ed9560706148a37e75017FA9E08b3980

# x402 facilitator URL (Coinbase CDP facilitator for Base mainnet, or x402.org for Base Sepolia testnet)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Required when using the CDP facilitator on Base mainnet
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Use "base" for mainnet (requires CDP facilitator) or "base-sepolia" for x402.org testnet
X402_NETWORK=base

# Per-route pricing in USD (override defaults here)
X402_PRICE_SESSION_START=0.19
X402_PRICE_GENERATE=0.49
X402_PRICE_RATE=0.01
X402_PRICE_CAPTION_SUGGEST=0.10
X402_PRICE_CAPTION_RATE=0.01

# === Primary database (Supabase Postgres) ===
# Required for brandify sessions, caption pipeline, and public variations.
# Session mode: port 5432  |  Transaction pooler (Render): port 6543 + ?pgbouncer=true
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Public origin URL used in /openapi.json (defaults to Render URL if unset)
X402_PUBLIC_ORIGIN=https://rekt-ceo-brandification.onrender.com

# Contact email in OpenAPI (used for x402scan/Poncho ownership verification)
X402_CONTACT_EMAIL=contact@rektceo.club
