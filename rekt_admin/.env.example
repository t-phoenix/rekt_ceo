#
# Copy to `.env`. Vite only exposes vars prefixed with VITE_ (except NODE_ENV).
#

# Main Rekt backend (nft info, mint, auth nonce/verify) — PORT from that service, often 3000
VITE_API_URL=http://localhost:3000

# Launch Hub / campaigns API — REQUIRED when Launch Hub routes live in rekt_campaigns (default PORT 4047).
# If omitted, Campaigns page falls back to VITE_API_URL (won't work unless those routes are on the main API).
VITE_CAMPAIGN_API_URL=http://localhost:4047

# Brandify API (meme brandify + CMO Workshop) — default port 3001
VITE_BRANDIFY_API_URL=http://localhost:3001

# Optional — pre-fills the admin key in the UI during local dev (same value as ADMIN_API_KEY on brandify/campaigns)
VITE_ADMIN_API_KEY=

# WalletConnect (required for Wagmi / Web3Modal)
VITE_WALLETCONNECT_PROJECT_ID=

# Alchemy (Sepolia mint/liquidity + optional Base RPC)
VITE_ALCHEMY_API_KEY=
VITE_CHAIN_ID=11155111

# Base (CMO x402 USDC payments) — defaults work if unset
# VITE_BASE_RPC_HTTP_URL=https://mainnet.base.org
# VITE_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Optional UI price labels (must match brandify X402_PRICE_CMO_* for accuracy)
# VITE_CMO_PRICE_COMPETITION=0.25
# VITE_CMO_PRICE_KOL=0.15
# VITE_CMO_PRICE_TRENDS=0.06
# VITE_CMO_PRICE_CONTENT_DRAFT=0.05
# VITE_CMO_PRICE_CAMPAIGN_BRIEF=0.10
# VITE_CMO_PRICE_TOPICS=0.21
# VITE_CMO_PRICE_SOCIAL_PULSE=0.36
# VITE_CMO_PRICE_NEWS_EVENTS=0.18
# VITE_CMO_PRICE_INTEL_PACK=0.75
# VITE_CMO_PRICE_CURATE=0.18
# VITE_CMO_PRICE_SELECT_TEMPLATE=0.03
# VITE_CMO_PRICE_BRANDIFY=0.48
# VITE_CMO_PRICE_CAPTION=0.24
# Day package UI label — match brandify (2× internal ≈ $0.60)
# VITE_CMO_PRICE_DAY_PACKAGE=0.60
